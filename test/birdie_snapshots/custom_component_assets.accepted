HTMLFile: test/workspace/pages/blog/second_post.md:/blog/second_post.html
<!doctype html>
<html lang="en">
  <head>
    <title>Second Post</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.png">
    <link href="/default.css" rel="stylesheet">
    <noscript>
      <link href="/index.css" rel="stylesheet">
    </noscript>
    <script defer="true" type="module" src="/index.js"></script>
  </head>
  <body>
    <header>
      <h1>Second Post</h1>
      <nav>
        <ul>
          <li>
            <a href="/special">special</a>
          </li>
          <li>
            <a href="/blog">blog</a>
          </li>
        </ul>
      </nav>
    </header>
    <main>
      <div>
        <h2>Welcome!</h2>
        <p>This is some content in Markdown that can be rendered to your site</p>
        <p>Here&#39;s a code block and some other
          <em>fancy</em>
          formatting</p>
        <data value="Nested Heading + code |> print_me |> echo +  + ">My Updated Tag</data>
        <p>
          <my-updated-async-tag data="hello world">Extracted text:
            hello world</my-updated-async-tag>
        </p>
        <h3>Some Images to Optimize</h3>
        <p>
          <img src="/optimized-images/test/workspace/static/images/image-1.webp" alt="image-1" aspect-ratio="1.4989969909729188">
        </p>
        <p>
          <img src="/optimized-images/test/workspace/static/images/image-2.webp" alt="image-2" aspect-ratio="1.5037593984962405">
        </p>
      </div>
    </main>
  </body>
</html>

